---
// Einladung zur Terminanfrage am Ende jeder Seite (außer Kontakt, Impressum, Datenschutz).
// Phase 1: Einladungstext, Button und E-Mail. In Phase 4 wird hier das Formular direkt eingebettet.
// Benutzt auf der Startseite und den Unterseiten.
import { ANKER, kontaktUrl, type Sprache } from '../config/site';
import { bogenPaar } from '../lib/bogen';
import { holeKontaktdaten, uebersetzer } from '../lib/inhalte';
import Icon from './Icon.astro';
import Text from './Text.astro';

interface Props {
  sprache: Sprache;
  /** Vorausgewähltes Anliegen, z. B. „adhs“ auf der ADHS-Seite */
  anliegen?: string;
}

const { sprache, anliegen } = Astro.props;
const t = await uebersetzer(sprache);
const kontakt = await holeKontaktdaten(sprache);
const [deko1, deko2] = bogenPaar(200, 200, 150, 12, 0.92);
---

<section class="abschnitt kontaktblock" id={ANKER.kontakt} aria-labelledby="kontaktblock-titel">
  <div class="inhalt">
    <div class="kontaktblock__karte">
      <svg class="kontaktblock__deko" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
        <path d={deko1} class="kontaktblock__bogen kontaktblock__bogen--1"></path>
        <path d={deko2} class="kontaktblock__bogen kontaktblock__bogen--2"></path>
        <circle cx="200" cy="200" r="7" class="kontaktblock__punkt"></circle>
      </svg>

      <div class="kontaktblock__text">
        <h2 id="kontaktblock-titel">{t('kontaktformular.ueberschrift')}</h2>
        <p class="kontaktblock__einleitung"><Text text={t('kontaktformular.einleitung')} /></p>
        <div class="kontaktblock__aktionen">
          <a class="button button--primaer" href={kontaktUrl(sprache, anliegen)} data-kontakt-oeffnen data-anliegen={anliegen}>
            {t('buttons.termin_anfragen')}
          </a>
          <p class="kontaktblock__mail">
            <span>{t('kontaktformular.direkt_email')}</span>
            <a href={`mailto:${kontakt.email}`}>
              <Icon name="mail" groesse={18} />
              {kontakt.email}
            </a>
          </p>
        </div>
        <p class="kontaktblock__zahler">{t('selbstzahler.kurz')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .kontaktblock__karte {
    position: relative;
    overflow: hidden;
    display: grid;
    padding: clamp(2rem, 1.2rem + 4vw, 5rem);
    background: var(--farbe-flaeche);
    border: var(--linie-duenn) solid var(--farbe-linie);
    border-radius: calc(var(--radius-karte) * 1.4);
  }

  .kontaktblock__deko {
    display: none;
    position: absolute;
    width: clamp(16rem, 30vw, 26rem);
    right: clamp(-9rem, -8vw, -3rem);
    bottom: clamp(-9rem, -8vw, -4rem);
    pointer-events: none;
  }

  /* Auf Handys ohne Deko, damit nichts den Text überlagert */
  @media (min-width: 48em) {
    .kontaktblock__deko {
      display: block;
    }
  }

  .kontaktblock__bogen {
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: 0.55;
  }

  .kontaktblock__bogen--1 {
    stroke: var(--farbe-bogen-1);
  }

  .kontaktblock__bogen--2 {
    stroke: var(--farbe-bogen-2);
  }

  .kontaktblock__punkt {
    fill: var(--farbe-punkt);
    opacity: 0.8;
  }

  .kontaktblock__text {
    position: relative;
    display: grid;
    gap: var(--raum-m);
    max-width: 38rem;
  }

  .kontaktblock__einleitung {
    font-size: var(--text-gross);
    line-height: 1.55;
    color: var(--farbe-text-leise);
  }

  .kontaktblock__aktionen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--raum-s) var(--raum-l);
    margin-top: var(--raum-xs);
  }

  .kontaktblock__mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--raum-2xs);
    color: var(--farbe-text-leise);
  }

  .kontaktblock__mail a {
    display: inline-flex;
    align-items: center;
    gap: var(--raum-2xs);
    min-height: var(--beruehrziel);
    font-weight: 600;
  }

  .kontaktblock__zahler {
    font-size: var(--text-klein);
    color: var(--farbe-text-leise);
  }
</style>
