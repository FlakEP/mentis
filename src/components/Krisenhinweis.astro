---
// Hinweis auf Hilfsangebote in akuten Krisen (Texte aus ui.yaml → krisenhinweis).
// Telefonnummern sind auf dem Handy direkt antippbar. Benutzt auf der Seite „Klinische Diagnostik“
// und (ab Phase 3) unter jedem Ergebnis eines klinischen Selbsttests.
import type { Sprache } from '../config/site';
import { uebersetzer } from '../lib/inhalte';
import { findeTelefonnummern } from '../lib/text';

interface Props {
  sprache: Sprache;
  /** Überschriftenebene: h2 als eigener Abschnitt, h4 innerhalb eines Selbsttest-Ergebnisses */
  ebene?: 'h2' | 'h3' | 'h4';
  id?: string;
}

const { sprache, ebene = 'h2', id = 'krisenhinweis' } = Astro.props;
const t = await uebersetzer(sprache);
const teile = findeTelefonnummern(t('krisenhinweis.text'));
const Ueberschrift = ebene;
// Als eigener Abschnitt ein Seitenbereich (aside); innerhalb eines Selbsttest-Ergebnisses ein normaler Block,
// damit es auf der klinischen Seite keine zwei gleichnamigen Seitenbereiche gibt.
const Huelle = ebene === 'h4' ? 'div' : 'aside';
---

<Huelle class="krise" aria-labelledby={ebene === 'h4' ? undefined : `${id}-titel`}>
  <Ueberschrift class="krise__titel" id={`${id}-titel`}>{t('krisenhinweis.ueberschrift')}</Ueberschrift>
  <p class="krise__text">
    {
      teile.map((teil) =>
        teil.art === 'telefon' ? (
          <a class="krise__telefon" href={`tel:${teil.nummer}`}>
            {teil.text}
          </a>
        ) : (
          teil.text
        ),
      )
    }
  </p>
</Huelle>

<style>
  .krise {
    display: grid;
    gap: var(--raum-xs);
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
    background: var(--farbe-flaeche-hinweis);
    border-left: 3px solid var(--farbe-primaer);
    border-radius: var(--radius-klein);
  }

  .krise__titel {
    font-size: var(--text-h3);
    font-weight: 500;
  }

  .krise__text {
    max-width: var(--textbreite);
  }

  .krise__telefon {
    color: var(--farbe-text);
    font-weight: 600;
    white-space: nowrap;
    text-decoration-color: var(--farbe-primaer);
  }
</style>
